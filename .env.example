# Percorso ASSOLUTO della cartella dei corsi sull'host (montata in sola lettura,
# allo stesso percorso dentro il container).
COURSES_DIR=/home/utente/StudyBuddy/Courses

# Opzionali
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# STUDYBUDDY_PORT=3000
# STUDYBUDDY_USER_NAME=           # nome nel saluto della home (vuoto: saluto senza nome)
# STUDYBUDDY_HOST=127.0.0.1       # 0.0.0.0 + STUDYBUDDY_ALLOWED_HOSTS per la LAN.
#                                 # Attenzione: l'allowlist degli Host NON è autenticazione,
#                                 # chiunque sulla LAN può usare l'app (e leggere i corsi).
# TZ=Europe/Rome                # fuso del saluto e delle date della home (in Docker il default è UTC)
# STUDYBUDDY_UID=1000             # uid/gid diversi da 1000 richiedono di ricostruire
# STUDYBUDDY_GID=1000             # l'immagine (/app/.next appartiene a 1000:1000).
# ANTHROPIC_API_KEY=              # solo se abiliti un task su Anthropic in config.ts

# Trascrizione (modulo SF6): locale con Whisper di default.
# TRANSCRIBE_BACKEND=groq          # opt-in: Groq Whisper in cloud (serve GROQ_API_KEY)
# GROQ_API_KEY=
# WHISPER_MODEL=base               # tiny|base|small|medium|large-v3 (locale)
# STUDYBUDDY_VODS_DIR=             # cartella dei VOD da trascrivere (default: data/vods, in Docker /app/data/vods)
